{
  "schemaVersion": 2,
  "suiteId": "linked-storage-sorting",
  "requires": [],
  "isolation": "testCell",
  "tests": [
    {
      "id": "sort-actions-reject-missing-menu",
      "tags": ["runtimeConformance", "sorting"],
      "timeoutTicks": 100,
      "steps": [
        {"id": "click-without-screen", "action": "menu.clickSortControl", "args": {"control": "mode"}, "expectFailure": "Storage inventory screen is not open"},
        {"id": "assert-without-menu", "action": "assert.sortMode", "args": {"mode": "COUNT"}, "expectFailure": "Storage inventory menu is not open on client"}
      ]
    },
    {
      "id": "linked-barrels-retain-sort-mode-on-reopen",
      "tags": ["linked", "menu", "sorting"],
      "timeoutTicks": 500,
      "steps": [
        {"id": "primary", "action": "fixture.block.set", "args": {"block": "sophisticatedstorage:barrel", "offset": [2, 0, -2]}},
        {"id": "secondary", "action": "fixture.block.set", "args": {"block": "sophisticatedstorage:barrel", "offset": [2, 0, -1]}},
        {"id": "await-primary", "action": "await.storageBlock"},
        {"id": "apples", "action": "storage.setBlockSlot", "args": {"slot": 0, "item": "minecraft:apple", "count": 2}},
        {"id": "diamonds", "action": "storage.setBlockSlot", "args": {"slot": 1, "item": "minecraft:diamond", "count": 17}},
        {"id": "linker", "action": "player.createMainHandItem", "args": {"item": "sophisticatedcore:ender_linker"}},
        {"id": "link-primary", "action": "player.useHeldItemOnTarget"},
        {"id": "link-secondary", "action": "player.useHeldItemOnTarget", "args": {"offsetZ": 1}},
        {"id": "clear-hand", "action": "player.clearMainHand"},
        {"id": "open-primary", "action": "player.useTargetBlock"},
        {"id": "await-primary-menu", "action": "await.menu", "args": {"kind": "storageBlock"}},
        {"id": "mode-mod", "action": "menu.clickSortControl", "args": {"control": "mode"}},
        {"id": "await-mod", "action": "assert.sortMode", "args": {"mode": "MOD"}},
        {"id": "mode-count", "action": "menu.clickSortControl", "args": {"control": "mode"}},
        {"id": "await-count", "action": "assert.sortMode", "args": {"mode": "COUNT"}},
        {"id": "sort", "action": "menu.clickSortControl", "args": {"control": "sort"}},
        {"id": "sorted-by-count", "action": "assert.menu", "args": {"kind": "storageBlock", "slot": 0, "item": "minecraft:diamond", "count": 17}},
        {"id": "close-primary", "action": "menu.close"},
        {"id": "await-primary-closed", "action": "await.menuClosed"},
        {"id": "reopen-primary", "action": "player.useTargetBlock"},
        {"id": "await-primary-reopened", "action": "await.menu", "args": {"kind": "storageBlock"}},
        {"id": "primary-count-retained", "action": "assert.sortMode", "args": {"mode": "COUNT"}},
        {"id": "close-primary-again", "action": "menu.close"},
        {"id": "await-primary-closed-again", "action": "await.menuClosed"},
        {"id": "open-secondary", "action": "player.useHeldItemOnTarget", "args": {"offsetZ": 1}},
        {"id": "secondary-count-retained", "action": "assert.sortMode", "args": {"mode": "COUNT"}},
        {"id": "secondary-mode-tags", "action": "menu.clickSortControl", "args": {"control": "mode"}},
        {"id": "secondary-tags", "action": "assert.sortMode", "args": {"mode": "TAGS"}},
        {"id": "close-secondary", "action": "menu.close"},
        {"id": "await-secondary-closed", "action": "await.menuClosed"},
        {"id": "open-primary-again", "action": "player.useTargetBlock"},
        {"id": "await-primary-again", "action": "await.menu", "args": {"kind": "storageBlock"}},
        {"id": "primary-sees-secondary-mode", "action": "assert.sortMode", "args": {"mode": "TAGS"}}
      ]
    },
    {
      "id": "backpack-primary-sort-mode-seeds-linked-barrel",
      "tags": ["linked", "menu", "sorting"],
      "timeoutTicks": 500,
      "steps": [
        {"id": "survival-inventory", "action": "fixture.player.setGameMode", "args": {"mode": "survival"}},
        {"id": "barrel", "action": "fixture.block.set", "args": {"block": "sophisticatedstorage:barrel", "offset": [2, 0, -2]}},
        {"id": "await-barrel", "action": "await.storageBlock"},
        {"id": "backpack", "action": "backpack.createInMainHand", "args": {"tier": "leather"}},
        {"id": "open-backpack", "action": "player.useHeldItem"},
        {"id": "await-backpack", "action": "await.menu", "args": {"kind": "backpackItem"}},
        {"id": "mode-mod", "action": "menu.clickSortControl", "args": {"control": "mode"}},
        {"id": "await-mod", "action": "assert.sortMode", "args": {"mode": "MOD"}},
        {"id": "mode-count", "action": "menu.clickSortControl", "args": {"control": "mode"}},
        {"id": "await-count", "action": "assert.sortMode", "args": {"mode": "COUNT"}},
        {"id": "close-backpack", "action": "menu.close"},
        {"id": "await-backpack-closed", "action": "await.menuClosed"},
        {"id": "linker", "action": "player.setInventorySlot", "args": {"slot": 12, "item": "sophisticatedcore:ender_linker", "count": 1}},
        {"id": "inventory", "action": "player.openInventory"},
        {"id": "pickup-linker", "action": "menu.clickPlayerInventorySlot", "args": {"slot": 12}},
        {"id": "link-backpack", "action": "menu.clickPlayerInventorySlot", "args": {"slot": 0, "button": 1}},
        {"id": "put-linker", "action": "menu.clickPlayerInventorySlot", "args": {"slot": 12}},
        {"id": "store-backpack", "action": "menu.clickPlayerInventorySlot", "args": {"slot": 0}},
        {"id": "backpack-slot", "action": "menu.clickPlayerInventorySlot", "args": {"slot": 8}},
        {"id": "pickup-bound-linker", "action": "menu.clickPlayerInventorySlot", "args": {"slot": 12}},
        {"id": "hold-linker", "action": "menu.clickPlayerInventorySlot", "args": {"slot": 0}},
        {"id": "close-inventory", "action": "menu.close"},
        {"id": "await-inventory-closed", "action": "await.menuClosed"},
        {"id": "link-barrel", "action": "player.useHeldItemOnTarget"},
        {"id": "clear-hand", "action": "player.clearMainHand"},
        {"id": "open-barrel", "action": "player.useTargetBlock"},
        {"id": "await-barrel-menu", "action": "await.menu", "args": {"kind": "storageBlock"}},
        {"id": "seeded-count", "action": "assert.sortMode", "args": {"mode": "COUNT"}},
        {"id": "mode-tags", "action": "menu.clickSortControl", "args": {"control": "mode"}},
        {"id": "await-tags", "action": "assert.sortMode", "args": {"mode": "TAGS"}},
        {"id": "close-barrel", "action": "menu.close"},
        {"id": "await-barrel-closed", "action": "await.menuClosed"},
        {"id": "inventory-again", "action": "player.openInventory"},
        {"id": "pickup-backpack", "action": "menu.clickPlayerInventorySlot", "args": {"slot": 8}},
        {"id": "hold-backpack", "action": "menu.clickPlayerInventorySlot", "args": {"slot": 0}},
        {"id": "close-inventory-again", "action": "menu.close"},
        {"id": "await-inventory-closed-again", "action": "await.menuClosed"},
        {"id": "reopen-backpack", "action": "player.useHeldItem"},
        {"id": "await-backpack-reopened", "action": "await.menu", "args": {"kind": "backpackItem"}},
        {"id": "backpack-sees-barrel-mode", "action": "assert.sortMode", "args": {"mode": "TAGS"}}
      ]
    }
  ]
}
