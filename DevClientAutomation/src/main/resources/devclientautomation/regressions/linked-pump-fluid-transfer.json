        {"id": "close-inventory", "action": "menu.close"},
        {"id": "await-inventory-closed", "action": "await.menuClosed"},
        {"id": "water-bucket", "action": "player.setInventorySlot", "args": {"slot": 0, "item": "minecraft:water_bucket", "count": 1}},
        {"id": "pump", "action": "capability.transferLinkedPumpFluid", "args": {"direction": "input", "held": "bucket"}}
      ]
    },
    {
      "id": "output-to-ordinary-bucket",
      "tags": ["linked", "fluid", "pump", "output", "bucket"],
