        {"id": "close-inventory", "action": "menu.close"},
        {"id": "await-inventory-closed", "action": "await.menuClosed"},
        {"id": "empty-bucket", "action": "player.setInventorySlot", "args": {"slot": 0, "item": "minecraft:bucket", "count": 1}},
