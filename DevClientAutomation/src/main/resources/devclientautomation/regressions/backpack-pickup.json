        {"id": "synchronized-menu", "action": "await.menu", "args": {"kind": "backpackItem"}},
        {"id": "settings", "action": "assert.backpackPickupConfiguration", "args": {"upgrade": "advanced", "filterMode": "block", "filterItem": "minecraft:redstone"}},
        {"id": "backpack", "action": "assert.inventoryCount", "args": {"target": "backpack", "item": "minecraft:redstone", "count": 0, "client": true}},
        {"id": "player", "action": "assert.inventoryCount", "args": {"target": "player", "item": "minecraft:redstone", "count": 1, "client": true}}
