{
  "schemaVersion": 2,
  "suiteId": "backpack-crafting",
  "requires": [],
  "isolation": "testCell",
  "tests": [
    {
      "id": "shapeless-recipe-insertion-replacement-and-removal",
      "tags": ["backpack", "crafting", "shapeless", "sync"],
      "timeoutTicks": 600,
      "prepareTestCell": false,
      "steps": [
        {"id": "survival", "action": "fixture.player.setGameMode", "args": {"mode": "survival"}},
        {"id": "backpack", "action": "backpack.createInMainHand", "args": {"tier": "diamond"}},
        {"id": "crafting-upgrade", "action": "fixture.backpack.setUpgrade", "args": {"item": "sophisticatedbackpacks:crafting_upgrade"}},
        {"id": "oak-log", "action": "player.setInventorySlot", "args": {"slot": 9, "item": "minecraft:oak_log", "count": 1}},
        {"id": "birch-log", "action": "player.setInventorySlot", "args": {"slot": 10, "item": "minecraft:birch_log", "count": 1}},
        {"id": "open", "action": "player.useHeldItem"},
        {"id": "await-menu", "action": "await.menu", "args": {"kind": "backpackItem"}},
        {"id": "open-crafting-tab", "action": "menu.openUpgradeTab"},
        {"id": "empty-result", "action": "assert.upgradeSlot", "args": {"slot": 9, "item": "minecraft:air", "count": 0}},
        {"id": "pick-oak", "action": "menu.clickStorageSlot", "args": {"area": "player", "slot": 9, "click": "pickup"}},
        {"id": "insert-oak", "action": "menu.clickUpgradeSlot", "args": {"slot": 0}},
        {"id": "oak-input", "action": "assert.upgradeSlot", "args": {"slot": 0, "item": "minecraft:oak_log"}},
        {"id": "oak-result", "action": "assert.upgradeSlot", "args": {"slot": 9, "item": "minecraft:oak_planks", "count": 4}},
        {"id": "pick-birch", "action": "menu.clickStorageSlot", "args": {"area": "player", "slot": 10, "click": "pickup"}},
        {"id": "replace-oak-with-birch", "action": "menu.clickUpgradeSlot", "args": {"slot": 0}},
        {"id": "birch-input", "action": "assert.upgradeSlot", "args": {"slot": 0, "item": "minecraft:birch_log"}},
        {"id": "birch-result", "action": "assert.upgradeSlot", "args": {"slot": 9, "item": "minecraft:birch_planks", "count": 4}},
        {"id": "store-replaced-oak", "action": "menu.clickStorageSlot", "args": {"area": "player", "slot": 9, "click": "pickup"}},
        {"id": "remove-birch", "action": "menu.clickUpgradeSlot", "args": {"slot": 0}},
        {"id": "empty-input", "action": "assert.upgradeSlot", "args": {"slot": 0, "item": "minecraft:air", "count": 0}},
        {"id": "cleared-result", "action": "assert.upgradeSlot", "args": {"slot": 9, "item": "minecraft:air", "count": 0}}
      ]
    },
    {
      "id": "shaped-recipe-completion-repeated-take-and-reopen",
      "tags": ["backpack", "crafting", "shaped", "sync", "persistence"],
      "timeoutTicks": 600,
      "prepareTestCell": false,
      "steps": [
        {"id": "survival", "action": "fixture.player.setGameMode", "args": {"mode": "survival"}},
        {"id": "backpack", "action": "backpack.createInMainHand", "args": {"tier": "diamond"}},
        {"id": "crafting-upgrade", "action": "fixture.backpack.setUpgrade", "args": {"item": "sophisticatedbackpacks:crafting_upgrade"}},
        {"id": "planks", "action": "player.setInventorySlot", "args": {"slot": 9, "item": "minecraft:oak_planks", "count": 4}},
        {"id": "open", "action": "player.useHeldItem"},
        {"id": "await-menu", "action": "await.menu", "args": {"kind": "backpackItem"}},
        {"id": "open-crafting-tab", "action": "menu.openUpgradeTab"},
        {"id": "pick-planks", "action": "menu.clickStorageSlot", "args": {"area": "player", "slot": 9, "click": "pickup"}},
        {"id": "place-first-plank", "action": "menu.clickUpgradeSlot", "args": {"slot": 4, "button": 1}},
        {"id": "place-second-plank", "action": "menu.clickUpgradeSlot", "args": {"slot": 4, "button": 1}},
        {"id": "single-cell-button-result", "action": "assert.upgradeSlot", "args": {"slot": 9, "item": "minecraft:oak_button"}},
        {"id": "complete-offset-sticks", "action": "menu.clickUpgradeSlot", "args": {"slot": 7}},
        {"id": "sticks-result", "action": "assert.upgradeSlot", "args": {"slot": 9, "item": "minecraft:stick", "count": 4}},
        {"id": "take-first-result", "action": "menu.clickUpgradeSlot", "args": {"slot": 9}},
        {"id": "next-result", "action": "assert.upgradeSlot", "args": {"slot": 9, "item": "minecraft:stick", "count": 4}},
        {"id": "remaining-top-plank", "action": "assert.upgradeSlot", "args": {"slot": 4, "item": "minecraft:oak_planks"}},
        {"id": "remaining-bottom-plank", "action": "assert.upgradeSlot", "args": {"slot": 7, "item": "minecraft:oak_planks"}},
        {"id": "store-first-sticks", "action": "menu.clickStorageSlot", "args": {"area": "storage", "slot": 0, "click": "pickup"}},
        {"id": "take-last-result", "action": "menu.clickUpgradeSlot", "args": {"slot": 9}},
        {"id": "last-result-cleared", "action": "assert.upgradeSlot", "args": {"slot": 9, "item": "minecraft:air", "count": 0}},
        {"id": "top-consumed", "action": "assert.upgradeSlot", "args": {"slot": 4, "item": "minecraft:air", "count": 0}},
        {"id": "bottom-consumed", "action": "assert.upgradeSlot", "args": {"slot": 7, "item": "minecraft:air", "count": 0}},
        {"id": "store-last-sticks", "action": "menu.clickStorageSlot", "args": {"area": "storage", "slot": 0, "click": "pickup"}},
        {"id": "all-eight-sticks", "action": "assert.menu", "args": {"kind": "backpackItem", "item": "minecraft:stick", "count": 8}},
        {"id": "close", "action": "menu.close"},
        {"id": "closed", "action": "await.menuClosed"},
        {"id": "reopen", "action": "player.useHeldItem"},
        {"id": "reopened", "action": "await.menu", "args": {"kind": "backpackItem"}},
        {"id": "reopen-crafting-tab", "action": "menu.openUpgradeTab"},
        {"id": "still-empty-result", "action": "assert.upgradeSlot", "args": {"slot": 9, "item": "minecraft:air", "count": 0}},
        {"id": "persisted-sticks", "action": "assert.menu", "args": {"kind": "backpackItem", "item": "minecraft:stick", "count": 8}}
      ]
    },
    {
      "id": "shift-craft-refills-grid-and-exhausts-storage",
      "tags": ["backpack", "crafting", "sync", "quick-move", "refill"],
      "timeoutTicks": 600,
      "prepareTestCell": false,
      "steps": [
        {"id": "survival", "action": "fixture.player.setGameMode", "args": {"mode": "survival"}},
        {"id": "backpack", "action": "backpack.createInMainHand", "args": {"tier": "diamond"}},
        {"id": "crafting-upgrade", "action": "fixture.backpack.setUpgrade", "args": {"item": "sophisticatedbackpacks:crafting_upgrade"}},
        {"id": "reserve-logs", "action": "backpack.setStorageSlot", "args": {"item": "minecraft:oak_log", "count": 2}},
        {"id": "first-log", "action": "player.setInventorySlot", "args": {"slot": 9, "item": "minecraft:oak_log", "count": 1}},
        {"id": "open", "action": "player.useHeldItem"},
        {"id": "await-menu", "action": "await.menu", "args": {"kind": "backpackItem"}},
        {"id": "open-crafting-tab", "action": "menu.openUpgradeTab"},
        {"id": "enable-refill", "action": "menu.setCraftingRefill", "args": {"enabled": true}},
        {"id": "pick-log", "action": "menu.clickStorageSlot", "args": {"area": "player", "slot": 9, "click": "pickup"}},
        {"id": "insert-log", "action": "menu.clickUpgradeSlot", "args": {"slot": 8}},
        {"id": "first-result", "action": "assert.upgradeSlot", "args": {"slot": 9, "item": "minecraft:oak_planks", "count": 4}},
        {"id": "shift-craft", "action": "menu.clickUpgradeSlot", "args": {"slot": 9, "click": "quickMove"}},
        {"id": "all-twelve-planks", "action": "assert.inventoryCount", "args": {"target": "backpack", "item": "minecraft:oak_planks", "count": 12, "client": true}},
        {"id": "grid-exhausted", "action": "assert.upgradeSlot", "args": {"slot": 8, "item": "minecraft:air", "count": 0}},
        {"id": "result-exhausted", "action": "assert.upgradeSlot", "args": {"slot": 9, "item": "minecraft:air", "count": 0}}
      ]
    },
    {
      "id": "recipe-remainder-replaced-by-next-recipe",
      "tags": ["backpack", "crafting", "sync", "remainder"],
      "timeoutTicks": 600,
      "prepareTestCell": false,
      "steps": [
        {"id": "survival", "action": "fixture.player.setGameMode", "args": {"mode": "survival"}},
        {"id": "backpack", "action": "backpack.createInMainHand", "args": {"tier": "diamond"}},
        {"id": "crafting-upgrade", "action": "fixture.backpack.setUpgrade", "args": {"item": "sophisticatedbackpacks:crafting_upgrade"}},
        {"id": "honey", "action": "player.setInventorySlot", "args": {"slot": 9, "item": "minecraft:honey_bottle", "count": 1}},
        {"id": "log", "action": "player.setInventorySlot", "args": {"slot": 10, "item": "minecraft:birch_log", "count": 1}},
        {"id": "open", "action": "player.useHeldItem"},
        {"id": "await-menu", "action": "await.menu", "args": {"kind": "backpackItem"}},
        {"id": "open-crafting-tab", "action": "menu.openUpgradeTab"},
        {"id": "pick-honey", "action": "menu.clickStorageSlot", "args": {"area": "player", "slot": 9, "click": "pickup"}},
        {"id": "insert-honey", "action": "menu.clickUpgradeSlot", "args": {"slot": 8}},
        {"id": "sugar-result", "action": "assert.upgradeSlot", "args": {"slot": 9, "item": "minecraft:sugar", "count": 3}},
        {"id": "take-sugar", "action": "menu.clickUpgradeSlot", "args": {"slot": 9}},
        {"id": "bottle-remains", "action": "assert.upgradeSlot", "args": {"slot": 8, "item": "minecraft:glass_bottle"}},
        {"id": "sugar-result-cleared", "action": "assert.upgradeSlot", "args": {"slot": 9, "item": "minecraft:air", "count": 0}},
        {"id": "store-sugar", "action": "menu.clickStorageSlot", "args": {"area": "storage", "slot": 0, "click": "pickup"}},
        {"id": "sugar-count", "action": "assert.menu", "args": {"kind": "backpackItem", "item": "minecraft:sugar", "count": 3}},
        {"id": "pick-log", "action": "menu.clickStorageSlot", "args": {"area": "player", "slot": 10, "click": "pickup"}},
        {"id": "replace-bottle", "action": "menu.clickUpgradeSlot", "args": {"slot": 8}},
        {"id": "next-recipe-result", "action": "assert.upgradeSlot", "args": {"slot": 9, "item": "minecraft:birch_planks", "count": 4}},
        {"id": "store-bottle", "action": "menu.clickStorageSlot", "args": {"area": "storage", "slot": 1, "click": "pickup"}},
        {"id": "bottle-count", "action": "assert.menu", "args": {"kind": "backpackItem", "slot": 1, "item": "minecraft:glass_bottle"}}
      ]
    },
    {
      "id": "upgrade-slot-actions-reject-invalid-context-and-time-out",
      "tags": ["runtimeConformance"],
      "timeoutTicks": 400,
      "prepareTestCell": false,
      "steps": [
        {"id": "baseline", "action": "assert.playerInventoryBaseline"},
        {"id": "closed-click", "action": "menu.clickUpgradeSlot", "expectFailure": "Storage menu is not active"},
        {"id": "closed-tab-click", "action": "menu.openUpgradeTab", "expectFailure": "Storage screen is not active"},
        {"id": "closed-storage-click", "action": "menu.clickStorageSlot", "args": {"area": "storage", "click": "pickup"}, "expectFailure": "Storage menu is not active"},
        {"id": "closed-storage-quick-move", "action": "menu.quickMoveBackpackStorageSlot", "expectFailure": "Backpack menu is not active"},
        {"id": "closed-player-quick-move", "action": "menu.quickMovePlayerInventorySlot", "args": {"inventorySlot": 9}, "expectFailure": "Backpack menu is not active"},
        {"id": "closed-refill", "action": "menu.setCraftingRefill", "args": {"enabled": true}, "expectFailure": "Crafting upgrade is not active"},
        {"id": "closed-assertion", "action": "assert.upgradeSlot", "args": {"item": "minecraft:air", "count": 0}, "expectFailure": "Storage menu is not active"},
        {"id": "survival", "action": "fixture.player.setGameMode", "args": {"mode": "survival"}},
        {"id": "quick-move-marker", "action": "player.setInventorySlot", "args": {"slot": 9, "item": "minecraft:iron_ingot", "count": 2}},
        {"id": "open-player-inventory", "action": "player.openInventory"},
        {"id": "pickup-player-marker", "action": "menu.clickPlayerInventorySlot", "args": {"slot": 9}},
        {"id": "replace-player-marker", "action": "menu.clickPlayerInventorySlot", "args": {"slot": 10}},
        {"id": "close-player-inventory", "action": "menu.close"},
        {"id": "await-player-inventory-closed", "action": "await.menuClosed"},
        {"id": "backpack", "action": "backpack.createInMainHand", "args": {"tier": "diamond"}},
        {"id": "crafting-upgrade", "action": "fixture.backpack.setUpgrade", "args": {"item": "sophisticatedbackpacks:crafting_upgrade"}},
        {"id": "open", "action": "player.useHeldItem"},
        {"id": "await-menu", "action": "await.menu", "args": {"kind": "backpackItem"}},
        {"id": "closed-tab-slot-click", "action": "menu.clickUpgradeSlot", "expectFailure": "Upgrade tab is not open"},
        {"id": "closed-tab-refill", "action": "menu.setCraftingRefill", "args": {"enabled": true}, "expectFailure": "Crafting upgrade tab is not open"},
        {"id": "missing-tab", "action": "menu.openUpgradeTab", "args": {"upgrade": 1}, "expectFailure": "Menu has no upgrade 1"},
        {"id": "open-crafting-tab", "action": "menu.openUpgradeTab"},
        {"id": "already-open-tab", "action": "menu.openUpgradeTab"},
        {"id": "enable-refill", "action": "menu.setCraftingRefill", "args": {"enabled": true}},
        {"id": "already-enabled-refill", "action": "menu.setCraftingRefill", "args": {"enabled": true}},
        {"id": "disable-refill", "action": "menu.setCraftingRefill", "args": {"enabled": false}},
        {"id": "quick-move-player-marker", "action": "menu.quickMovePlayerInventorySlot", "args": {"inventorySlot": 10}},
        {"id": "marker-in-backpack", "action": "assert.menu", "args": {"kind": "backpackItem", "item": "minecraft:iron_ingot", "count": 2}},
        {"id": "quick-move-storage-marker", "action": "menu.quickMoveBackpackStorageSlot"},
        {"id": "marker-in-player", "action": "assert.menu", "args": {"kind": "backpackItem", "playerInventory": true, "slot": 8, "item": "minecraft:iron_ingot", "count": 2}},
        {"id": "shift-click-player-marker", "action": "menu.clickStorageSlot", "args": {"area": "player", "slot": 8, "click": "quickMove"}},
        {"id": "shifted-marker-in-backpack", "action": "assert.menu", "args": {"kind": "backpackItem", "item": "minecraft:iron_ingot", "count": 2}},
        {"id": "shift-click-storage-marker", "action": "menu.clickStorageSlot", "args": {"area": "storage", "click": "quickMove"}},
        {"id": "shifted-marker-in-player", "action": "assert.menu", "args": {"kind": "backpackItem", "playerInventory": true, "slot": 8, "item": "minecraft:iron_ingot", "count": 2}},
        {"id": "missing-upgrade", "action": "menu.clickUpgradeSlot", "args": {"upgrade": 1}, "expectFailure": "Menu has no upgrade 1 slot 0"},
        {"id": "missing-refill-upgrade", "action": "menu.setCraftingRefill", "args": {"upgrade": 1, "enabled": true}, "expectFailure": "Crafting upgrade is not active at upgrade 1"},
        {"id": "missing-click-slot", "action": "menu.clickUpgradeSlot", "args": {"slot": 10}, "expectFailure": "Menu has no upgrade 0 slot 10"},
        {"id": "missing-assertion-slot", "action": "assert.upgradeSlot", "args": {"slot": 10, "item": "minecraft:air", "count": 0}, "expectFailure": "Menu has no upgrade 0 slot 10"},
        {"id": "timeout", "action": "assert.upgradeSlot", "args": {"slot": 9, "item": "minecraft:diamond", "timeoutTicks": 5}, "expectFailure": "Upgrade slot did not synchronize expected"},
        {"id": "empty-result-after-timeout", "action": "assert.upgradeSlot", "args": {"slot": 9, "item": "minecraft:air", "count": 0}}
      ]
    },
    {
      "id": "crafting-cleanup-restores-player-baseline",
      "tags": ["runtimeConformance", "repeatability", "cleanup"],
      "timeoutTicks": 100,
      "prepareTestCell": false,
      "steps": [{"id": "baseline", "action": "assert.playerInventoryBaseline"}]
    }
  ]
}
