{
  "schemaVersion": 2,
  "suiteId": "moving-linked-storage",
  "requires": [],
  "isolation": "testCell",
  "tests": [
    {
      "id": "boat-link-through-entity-interaction",
      "tags": ["moving", "link", "boat", "sorting"],
      "timeoutTicks": 600,
      "steps": [
        {"id": "spawn-boat", "action": "fixture.moving.spawn", "args": {"kind": "boat", "saveAs": "boat"}},
        {"id": "seed-diamonds", "action": "moving.setSlot", "args": {"ref": "boat", "item": "minecraft:diamond", "count": 7}},
        {"id": "empty-hand-before-open", "action": "player.clearMainHand"},
        {"id": "open-unlinked-boat", "action": "player.useMovingStorage", "args": {"ref": "boat"}},
        {"id": "await-unlinked-menu", "action": "await.menu", "args": {"kind": "moving", "ref": "boat"}},
        {"id": "select-mod-before-linking", "action": "menu.clickSortControl", "args": {"control": "mode"}},
        {"id": "assert-unlinked-mod", "action": "assert.sortMode", "args": {"mode": "MOD"}},
        {"id": "select-count-before-linking", "action": "menu.clickSortControl", "args": {"control": "mode"}},
        {"id": "assert-unlinked-count", "action": "assert.sortMode", "args": {"mode": "COUNT"}},
        {"id": "close-unlinked-menu", "action": "menu.close"},
        {"id": "await-unlinked-close", "action": "await.menuClosed"},
        {"id": "hold-linker", "action": "player.createMainHandItem", "args": {"item": "sophisticatedcore:ender_linker"}},
        {"id": "link-boat", "action": "player.useMovingStorage", "args": {"ref": "boat"}},
        {"id": "assert-identity", "action": "assert.movingLinked", "args": {"ref": "boat", "primary": true, "count": 7}},
        {"id": "spawn-secondary-cart", "action": "fixture.moving.spawn", "args": {"kind": "minecart", "offsetX": 4, "saveAs": "secondary"}},
        {"id": "link-secondary-cart", "action": "player.useMovingStorage", "args": {"ref": "secondary"}},
        {"id": "clear-hand", "action": "player.clearMainHand"},
        {"id": "open-boat", "action": "player.useMovingStorage", "args": {"ref": "boat"}},
        {"id": "await-menu", "action": "await.menu", "args": {"kind": "moving", "ref": "boat"}},
        {"id": "assert-canonical-menu", "action": "assert.menu", "args": {"kind": "moving", "ref": "boat", "item": "minecraft:diamond", "count": 7}},
        {"id": "assert-group-title-and-primary-icon", "action": "assert.movingMenuPresentation", "args": {"ref": "boat", "role": "primary"}},
        {"id": "assert-linked-count", "action": "assert.sortMode", "args": {"mode": "COUNT"}},
        {"id": "select-linked-tags", "action": "menu.clickSortControl", "args": {"control": "mode"}},
        {"id": "assert-linked-tags", "action": "assert.sortMode", "args": {"mode": "TAGS"}},
        {"id": "close-menu", "action": "menu.close"},
        {"id": "await-closed", "action": "await.menuClosed"},
        {"id": "reopen-boat", "action": "player.useMovingStorage", "args": {"ref": "boat"}},
        {"id": "await-reopened", "action": "await.menu", "args": {"kind": "moving", "ref": "boat"}},
        {"id": "retained-tags", "action": "assert.sortMode", "args": {"mode": "TAGS"}},
        {"id": "close-reopened-menu", "action": "menu.close"},
        {"id": "await-reopened-close", "action": "await.menuClosed"},
        {"id": "open-secondary-cart", "action": "player.useMovingStorage", "args": {"ref": "secondary"}},
        {"id": "await-secondary-menu", "action": "await.menu", "args": {"kind": "moving", "ref": "secondary"}},
        {"id": "assert-secondary-tags", "action": "assert.sortMode", "args": {"mode": "TAGS"}}
      ]
    },
