        {"id": "assert-migrated", "action": "assert.movingLinked", "args": {"ref": "boat", "primary": true, "count": 7, "hostItem": "sophisticatedstorage:iron_barrel", "handCount": 1}},
        {"id": "assert-secondary-sees-migration", "action": "assert.movingLinked", "args": {"ref": "minecart", "count": 7, "hostItem": "sophisticatedstorage:iron_barrel"}}
      ]
