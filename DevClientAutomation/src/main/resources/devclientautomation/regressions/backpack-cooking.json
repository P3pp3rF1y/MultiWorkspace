{
  "schemaVersion": 2,
  "suiteId": "backpack-cooking",
  "requires": [],
  "isolation": "testCell",
  "tests": [
    {
      "id": "normal-smelting-wet-sponge-retains-water-bucket",
      "tags": ["backpack", "cooking", "wet-sponge", "persistence", "maintain287"],
      "timeoutTicks": 900,
      "prepareTestCell": false,
      "steps": [
        {"id": "survival", "action": "fixture.player.setGameMode", "args": {"mode": "survival"}},
        {"id": "backpack", "action": "backpack.createInMainHand", "args": {"tier": "diamond"}},
        {"id": "cooking-upgrade", "action": "fixture.backpack.setUpgrade", "args": {"item": "sophisticatedbackpacks:smelting_upgrade"}},
        {"id": "wet-sponge", "action": "player.setInventorySlot", "args": {"slot": 9, "item": "minecraft:wet_sponge", "count": 1}},
        {"id": "lava-bucket", "action": "player.setInventorySlot", "args": {"slot": 10, "item": "minecraft:lava_bucket", "count": 1}},
        {"id": "fill-storage", "action": "backpack.fillStorage", "args": {"item": "minecraft:cobblestone"}},
        {"id": "open", "action": "player.useHeldItem"},
        {"id": "await-menu", "action": "await.menu", "args": {"kind": "backpackItem"}},
        {"id": "storage-full", "action": "assert.inventoryCount", "args": {"target": "backpack", "item": "minecraft:sponge", "count": 0, "fullItem": "minecraft:cobblestone", "client": true}},
        {"id": "open-cooking-tab", "action": "menu.openUpgradeTab"},
        {"id": "pick-lava", "action": "menu.clickStorageSlot", "args": {"area": "player", "slot": 10, "click": "pickup"}},
        {"id": "insert-lava", "action": "menu.clickUpgradeSlot", "args": {"slot": 1}},
        {"id": "pick-wet-sponge", "action": "menu.clickStorageSlot", "args": {"area": "player", "slot": 9, "click": "pickup"}},
        {"id": "insert-wet-sponge", "action": "menu.clickUpgradeSlot", "args": {"slot": 0}},
        {"id": "input-consumed", "action": "assert.upgradeSlot", "args": {"slot": 0, "item": "minecraft:air", "count": 0, "timeoutTicks": 900, "stableTicks": 25}},
        {"id": "water-bucket-retained", "action": "assert.upgradeSlot", "args": {"slot": 1, "item": "minecraft:water_bucket", "count": 1, "timeoutTicks": 900, "stableTicks": 25}},
        {"id": "sponge-retained", "action": "assert.upgradeSlot", "args": {"slot": 2, "item": "minecraft:sponge", "count": 1, "timeoutTicks": 900, "stableTicks": 25}},
        {"id": "close", "action": "menu.close"},
        {"id": "closed", "action": "await.menuClosed"},
        {"id": "reopen", "action": "player.useHeldItem"},
        {"id": "reopened", "action": "await.menu", "args": {"kind": "backpackItem"}},
        {"id": "reopen-cooking-tab", "action": "menu.openUpgradeTab"},
        {"id": "reopened-water-bucket", "action": "assert.upgradeSlot", "args": {"slot": 1, "item": "minecraft:water_bucket", "count": 1, "stableTicks": 25}},
        {"id": "reopened-sponge", "action": "assert.upgradeSlot", "args": {"slot": 2, "item": "minecraft:sponge", "count": 1, "stableTicks": 25}},
        {"id": "close-before-reinstall", "action": "menu.close"},
        {"id": "closed-before-reinstall", "action": "await.menuClosed"},
        {"id": "reopen-main", "action": "player.useHeldItem"},
        {"id": "reopened-main", "action": "await.menu", "args": {"kind": "backpackItem"}},
        {"id": "remove-upgrade", "action": "menu.clickStorageSlot", "args": {"area": "upgrade", "slot": 0, "click": "pickup"}},
        {"id": "store-upgrade", "action": "menu.clickStorageSlot", "args": {"area": "player", "slot": 11, "click": "pickup"}},
        {"id": "pick-upgrade", "action": "menu.clickStorageSlot", "args": {"area": "player", "slot": 11, "click": "pickup"}},
        {"id": "reinstall-upgrade", "action": "menu.clickStorageSlot", "args": {"area": "upgrade", "slot": 0, "click": "pickup"}},
        {"id": "open-reinstalled-cooking-tab", "action": "menu.openUpgradeTab"},
        {"id": "reinstalled-input-empty", "action": "assert.upgradeSlot", "args": {"slot": 0, "item": "minecraft:air", "count": 0, "stableTicks": 25}},
        {"id": "reinstalled-water-bucket", "action": "assert.upgradeSlot", "args": {"slot": 1, "item": "minecraft:water_bucket", "count": 1, "stableTicks": 25}},
        {"id": "reinstalled-sponge", "action": "assert.upgradeSlot", "args": {"slot": 2, "item": "minecraft:sponge", "count": 1, "stableTicks": 25}}
      ]
    },
    {
      "id": "auto-smelting-wet-sponge-retains-water-bucket-prepare",
      "tags": ["backpack", "cooking", "wet-sponge", "restart-prepare", "maintain287"],
      "playerState": "checkpointPrepare",
      "checkpoint": "auto-cooking-water-bucket",
      "timeoutTicks": 900,
      "steps": [
        {"id": "survival", "action": "fixture.player.setGameMode", "args": {"mode": "survival"}},
        {"id": "backpack", "action": "backpack.createInMainHand", "args": {"tier": "diamond"}},
        {"id": "cooking-upgrade", "action": "fixture.backpack.setUpgrade", "args": {"item": "sophisticatedbackpacks:auto_smelting_upgrade"}},
        {"id": "wet-sponge", "action": "player.setInventorySlot", "args": {"slot": 9, "item": "minecraft:wet_sponge", "count": 1}},
        {"id": "lava-bucket", "action": "player.setInventorySlot", "args": {"slot": 10, "item": "minecraft:lava_bucket", "count": 1}},
        {"id": "fill-storage", "action": "backpack.fillStorage", "args": {"item": "minecraft:cobblestone"}},
        {"id": "open", "action": "player.useHeldItem"},
        {"id": "await-menu", "action": "await.menu", "args": {"kind": "backpackItem"}},
        {"id": "storage-full", "action": "assert.inventoryCount", "args": {"target": "backpack", "item": "minecraft:sponge", "count": 0, "fullItem": "minecraft:cobblestone", "client": true}},
        {"id": "open-cooking-tab", "action": "menu.openUpgradeTab"},
        {"id": "pick-lava", "action": "menu.clickStorageSlot", "args": {"area": "player", "slot": 10, "click": "pickup"}},
        {"id": "insert-lava", "action": "menu.clickUpgradeSlot", "args": {"slot": 15}},
        {"id": "pick-wet-sponge", "action": "menu.clickStorageSlot", "args": {"area": "player", "slot": 9, "click": "pickup"}},
        {"id": "set-input-filter", "action": "menu.clickUpgradeSlot", "args": {"slot": 1}},
        {"id": "input-filter-wet-sponge", "action": "assert.upgradeSlot", "args": {"slot": 1, "item": "minecraft:wet_sponge", "count": 1, "timeoutTicks": 100}},
        {"id": "insert-wet-sponge", "action": "menu.clickUpgradeSlot", "args": {"slot": 14}},
        {"id": "input-accepted", "action": "assert.upgradeSlot", "args": {"slot": 14, "item": "minecraft:wet_sponge", "count": 1, "timeoutTicks": 100}},
        {"id": "input-consumed", "action": "assert.upgradeSlot", "args": {"slot": 14, "item": "minecraft:air", "count": 0, "timeoutTicks": 900, "stableTicks": 25}},
        {"id": "water-bucket-retained", "action": "assert.upgradeSlot", "args": {"slot": 15, "item": "minecraft:water_bucket", "count": 1, "timeoutTicks": 900, "stableTicks": 25}},
        {"id": "sponge-retained", "action": "assert.upgradeSlot", "args": {"slot": 16, "item": "minecraft:sponge", "count": 1, "timeoutTicks": 900, "stableTicks": 25}},
        {"id": "storage-remains-full", "action": "assert.inventoryCount", "args": {"target": "backpack", "item": "minecraft:sponge", "count": 0, "fullItem": "minecraft:cobblestone", "client": true}},
        {"id": "close", "action": "menu.close"},
        {"id": "closed", "action": "await.menuClosed"}
      ]
    },
    {
      "id": "auto-smelting-wet-sponge-water-bucket-restart",
      "tags": ["backpack", "cooking", "wet-sponge", "restart-verify", "maintain287"],
      "prepareTestCell": false,
      "playerState": "checkpointVerify",
      "checkpoint": "auto-cooking-water-bucket",
      "timeoutTicks": 900,
      "steps": [
        {"id": "open", "action": "player.useHeldItem"},
        {"id": "await-menu", "action": "await.menu", "args": {"kind": "backpackItem"}},
        {"id": "open-cooking-tab", "action": "menu.openUpgradeTab"},
        {"id": "input-empty", "action": "assert.upgradeSlot", "args": {"slot": 14, "item": "minecraft:air", "count": 0, "stableTicks": 25}},
        {"id": "water-bucket-retained", "action": "assert.upgradeSlot", "args": {"slot": 15, "item": "minecraft:water_bucket", "count": 1, "stableTicks": 25}},
        {"id": "sponge-retained", "action": "assert.upgradeSlot", "args": {"slot": 16, "item": "minecraft:sponge", "count": 1, "stableTicks": 25}},
        {"id": "storage-remains-full", "action": "assert.inventoryCount", "args": {"target": "backpack", "item": "minecraft:sponge", "count": 0, "fullItem": "minecraft:cobblestone", "client": true}},
        {"id": "close", "action": "menu.close"},
        {"id": "closed", "action": "await.menuClosed"}
      ]
    }
  ]
}
