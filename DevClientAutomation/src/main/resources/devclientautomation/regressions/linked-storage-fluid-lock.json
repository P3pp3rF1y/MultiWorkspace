{
  "schemaVersion": 2,
  "suiteId": "linked-storage-fluid-lock",
  "requires": [],
  "isolation": "testCell",
  "tests": [
    {
      "id": "locked-barrel-filters-canonical-fluid",
      "tags": ["linked", "fluid", "lock", "barrel"],
      "timeoutTicks": 500,
      "steps": [
        {"id": "barrel", "action": "fixture.block.set", "args": {"block": "sophisticatedstorage:barrel", "offset": [2, 0, -2]}},
        {"id": "await-storage", "action": "await.storageBlock"},
        {"id": "survival", "action": "fixture.player.setGameMode", "args": {"mode": "survival"}},
        {"id": "backpack", "action": "backpack.createInMainHand", "args": {"tier": "diamond"}},
        {"id": "tank", "action": "fixture.backpack.setUpgrade", "args": {"slot": 0, "item": "sophisticatedbackpacks:tank_upgrade"}},
        {"id": "battery", "action": "fixture.backpack.setUpgrade", "args": {"slot": 1, "item": "sophisticatedbackpacks:battery_upgrade"}},
        {"id": "linker", "action": "player.setInventorySlot", "args": {"slot": 9, "item": "sophisticatedcore:ender_linker", "count": 1}},
        {"id": "open-inventory", "action": "player.openInventory"},
        {"id": "pickup-linker", "action": "menu.clickPlayerInventorySlot", "args": {"slot": 9}},
        {"id": "link-primary-backpack", "action": "menu.clickPlayerInventorySlot", "args": {"slot": 0, "button": 1}},
        {"id": "return-bound-linker", "action": "menu.clickPlayerInventorySlot", "args": {"slot": 9}},
        {"id": "pickup-backpack", "action": "menu.clickPlayerInventorySlot", "args": {"slot": 0}},
        {"id": "store-backpack", "action": "menu.clickPlayerInventorySlot", "args": {"slot": 8}},
        {"id": "pickup-bound-linker", "action": "menu.clickPlayerInventorySlot", "args": {"slot": 9}},
        {"id": "hold-bound-linker", "action": "menu.clickPlayerInventorySlot", "args": {"slot": 0}},
        {"id": "close-inventory", "action": "menu.close"},
        {"id": "await-inventory-closed", "action": "await.menuClosed"},
        {"id": "link-storage", "action": "player.useHeldItemOnTarget"},
        {"id": "empty-unlocked", "action": "assert.storageResources"},
        {"id": "lock-tool", "action": "fixture.storage.createLockTool"},
        {"id": "lock-empty-storage", "action": "player.useHeldItemOnTarget"},
        {"id": "reject-empty-simulation", "action": "capability.transferStorageResource", "args": {"operation": "fill", "amount": 1000, "expected": 0, "simulate": true}},
        {"id": "reject-empty-fill", "action": "capability.transferStorageResource", "args": {"operation": "fill", "amount": 1000, "expected": 0}},
        {"id": "still-empty", "action": "assert.storageResources"},
        {"id": "unlock-for-initial-fluid", "action": "player.useHeldItemOnTarget"},
        {"id": "initial-fluid", "action": "capability.transferStorageResource", "args": {"operation": "fill", "amount": 500}},
        {"id": "physical-endpoint-fill", "action": "capability.transferLinkedBackpackFluid", "args": {"slot": 8, "operation": "fill", "amount": 250, "expected": 250, "canonicalAmount": 750}},
        {"id": "physical-endpoint-drain", "action": "capability.transferLinkedBackpackFluid", "args": {"slot": 8, "operation": "drain", "amount": 250, "expected": 250, "canonicalAmount": 500}},
        {"id": "lock-nonempty-storage", "action": "player.useHeldItemOnTarget"},
        {"id": "allow-matching-simulation", "action": "capability.transferStorageResource", "args": {"operation": "fill", "amount": 250, "simulate": true}},
        {"id": "simulation-retains-fluid", "action": "assert.storageResources", "args": {"fluid": 500}},
        {"id": "allow-matching-fill", "action": "capability.transferStorageResource", "args": {"operation": "fill", "amount": 250}},
        {"id": "reject-other-fluid", "action": "capability.transferStorageResource", "args": {"operation": "fill", "amount": 250, "fluid": "lava", "expected": 0}},
        {"id": "matching-fluid-retained", "action": "assert.storageResources", "args": {"fluid": 750}},
        {"id": "drain-while-locked", "action": "capability.transferStorageResource", "args": {"operation": "drain", "amount": 750}},
        {"id": "reject-refill-after-emptying", "action": "capability.transferStorageResource", "args": {"operation": "fill", "amount": 250, "expected": 0}},
        {"id": "drained-empty", "action": "assert.storageResources"},
        {"id": "unlock-empty-storage", "action": "player.useHeldItemOnTarget"},
        {"id": "allow-fill-after-unlocking", "action": "capability.transferStorageResource", "args": {"operation": "fill", "amount": 1000}},
        {"id": "unlocked-fluid", "action": "assert.storageResources", "args": {"fluid": 1000}}
      ]
    },
