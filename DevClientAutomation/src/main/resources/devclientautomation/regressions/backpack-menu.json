{
  "schemaVersion": 2,
  "suiteId": "backpack-menu",
  "requires": [],
  "isolation": "testCell",
  "tests": [
    {
      "id": "held-backpack-tank-battery-swap-preserves-slot-layout",
      "tags": ["menu", "upgrade", "sync", "tank", "battery"],
      "timeoutTicks": 600,
      "steps": [
        {"id": "survival", "action": "fixture.player.setGameMode", "args": {"mode": "survival"}},
        {"id": "backpack", "action": "backpack.createInMainHand", "args": {"tier": "diamond"}},
        {"id": "stored-marker", "action": "backpack.setStorageSlot", "args": {"item": "minecraft:diamond", "count": 7}},
        {"id": "tank", "action": "player.setInventorySlot", "args": {"slot": 9, "item": "sophisticatedbackpacks:tank_upgrade", "count": 1}},
        {"id": "battery", "action": "player.setInventorySlot", "args": {"slot": 10, "item": "sophisticatedbackpacks:battery_upgrade", "count": 1}},
        {"id": "player-marker", "action": "player.setInventorySlot", "args": {"slot": 11, "item": "minecraft:cobblestone", "count": 13}},
        {"id": "open", "action": "player.useHeldItem"},
        {"id": "await-menu", "action": "await.menu", "args": {"kind": "backpackItem"}},
        {"id": "pickup-tank", "action": "menu.clickStorageSlot", "args": {"area": "player", "slot": 9, "click": "pickup"}},
        {"id": "install-tank-first-slot", "action": "menu.clickStorageSlot", "args": {"area": "upgrade", "slot": 0, "click": "pickup"}},
        {"id": "tank-layout", "action": "assert.menuUpgradeLayout", "args": {"columns": 2, "controls": 1, "contents": true}},
        {"id": "pickup-battery", "action": "menu.clickStorageSlot", "args": {"area": "player", "slot": 10, "click": "pickup"}},
        {"id": "swap-tank-for-battery", "action": "menu.clickStorageSlot", "args": {"area": "upgrade", "slot": 0, "click": "pickup"}},
        {"id": "battery-layout", "action": "assert.menuUpgradeLayout", "args": {"columns": 2, "controls": 1, "contents": true}},
        {"id": "install-carried-tank-second-slot", "action": "menu.clickStorageSlot", "args": {"area": "upgrade", "slot": 1, "click": "pickup"}},
        {"id": "both-layout", "action": "assert.menuUpgradeLayout", "args": {"columns": 4, "controls": 2, "contents": true}},
        {"id": "stored-marker-preserved", "action": "assert.menu", "args": {"kind": "backpackItem", "item": "minecraft:diamond", "count": 7}},
        {"id": "player-marker-preserved", "action": "assert.menu", "args": {"kind": "backpackItem", "playerInventory": true, "slot": 11, "item": "minecraft:cobblestone", "count": 13}},
        {"id": "pickup-marker", "action": "menu.clickStorageSlot", "args": {"area": "player", "slot": 11, "click": "pickup"}},
        {"id": "store-marker", "action": "menu.clickStorageSlot", "args": {"area": "storage", "slot": 1, "click": "pickup"}},
        {"id": "marker-transfer", "action": "assert.menu", "args": {"kind": "backpackItem", "slot": 1, "item": "minecraft:cobblestone", "count": 13, "stableTicks": 20}},
        {"id": "final-layout", "action": "assert.menuUpgradeLayout", "args": {"columns": 4, "controls": 2, "contents": true}},
        {"id": "close", "action": "menu.close"},
        {"id": "await-closed", "action": "await.menuClosed"},
        {"id": "reopen", "action": "player.useHeldItem"},
        {"id": "await-reopened", "action": "await.menu", "args": {"kind": "backpackItem"}},
        {"id": "persisted-layout", "action": "assert.menuUpgradeLayout", "args": {"columns": 4, "controls": 2, "contents": true}},
        {"id": "persisted-marker", "action": "assert.menu", "args": {"kind": "backpackItem", "slot": 1, "item": "minecraft:cobblestone", "count": 13}}
      ]
    },
    {
      "id": "backpack-actions-execute-with-valid-fixture",
      "tags": ["runtimeConformance", "action-conformance"],
      "timeoutTicks": 400,
      "steps": [
        {"id": "create-backpack", "action": "backpack.createInMainHand", "args": {"tier": "leather"}},
        {"id": "set-emeralds", "action": "backpack.setStorageSlot", "args": {"item": "minecraft:emerald", "count": 3}},
        {"id": "place-backpack", "action": "backpack.placeHeld"},
        {"id": "await-backpack", "action": "await.backpackBlock"},
        {"id": "clear-hand", "action": "player.clearMainHand"},
        {"id": "use-backpack", "action": "player.useTargetBlock"},
        {"id": "await-menu", "action": "await.menu"},
        {"id": "assert-menu", "action": "assert.menu", "args": {"item": "minecraft:emerald", "count": 3}}
      ]
    },
    {
      "id": "placed-backpack-opens-synchronized-menu",
      "tags": ["pilot", "menu", "interaction"],
      "timeoutTicks": 400,
      "steps": [
        {"id": "create-backpack", "action": "backpack.createInMainHand", "args": {"tier": "gold"}},
        {"id": "set-diamonds", "action": "backpack.setStorageSlot", "args": {"item": "minecraft:diamond", "count": 7}},
        {"id": "place-backpack", "action": "backpack.placeHeld"},
        {"id": "await-backpack", "action": "await.backpackBlock"},
        {"id": "clear-hand", "action": "player.clearMainHand"},
        {"id": "use-backpack", "action": "player.useTargetBlock"},
        {"id": "await-menu", "action": "await.menu"},
        {"id": "assert-menu", "action": "assert.menu", "args": {"item": "minecraft:diamond", "count": 7}}
      ]
    },
    {
      "id": "held-backpack-opens-synchronized-item-menu",
      "tags": ["menu", "interaction", "held-item"],
      "timeoutTicks": 400,
      "steps": [
        {"id": "create-backpack", "action": "backpack.createInMainHand", "args": {"tier": "diamond"}},
        {"id": "set-diamonds", "action": "backpack.setStorageSlot", "args": {"item": "minecraft:diamond", "count": 5}},
        {"id": "use-held-backpack", "action": "player.useHeldItem"},
        {"id": "await-item-menu", "action": "await.menu", "args": {"kind": "backpackItem"}},
        {"id": "assert-item-menu", "action": "assert.menu", "args": {"kind": "backpackItem", "item": "minecraft:diamond", "count": 5}},
        {"id": "close-menu", "action": "menu.close"},
        {"id": "await-closed", "action": "await.menuClosed"}
      ]
    },
    {
      "id": "placed-backpack-menu-click-and-quick-move-stay-synchronized",
      "tags": ["menu", "interaction", "click", "quick-move"],
      "timeoutTicks": 400,
      "steps": [
        {"id": "create-backpack", "action": "backpack.createInMainHand", "args": {"tier": "gold"}},
        {"id": "set-iron", "action": "backpack.setStorageSlot", "args": {"item": "minecraft:iron_ingot", "count": 1}},
        {"id": "set-stick", "action": "player.setInventorySlot", "args": {"slot": 9, "item": "minecraft:stick", "count": 1}},
        {"id": "place-backpack", "action": "backpack.placeHeld"},
        {"id": "await-backpack", "action": "await.backpackBlock"},
        {"id": "clear-hand", "action": "player.clearMainHand"},
        {"id": "use-backpack", "action": "player.useTargetBlock"},
        {"id": "await-menu", "action": "await.menu"},
        {"id": "pick-up-iron", "action": "menu.clickSlot", "args": {"slot": 0}},
        {"id": "put-down-iron", "action": "menu.clickSlot", "args": {"slot": 1}},
        {"id": "assert-iron", "action": "assert.menu", "args": {"slot": 1, "item": "minecraft:iron_ingot", "count": 1}},
        {"id": "quick-move-stick", "action": "menu.quickMovePlayerInventorySlot", "args": {"inventorySlot": 9}},
        {"id": "assert-stick", "action": "assert.menu", "args": {"item": "minecraft:stick", "count": 1}},
        {"id": "close-menu", "action": "menu.close"},
        {"id": "await-closed", "action": "await.menuClosed"}
      ]
    },
    {
      "id": "linked-held-backpack-opens-with-enchanted-book",
      "tags": ["menu", "linked-storage", "enchanted-item"],
      "timeoutTicks": 400,
      "steps": [
        {"id": "create-backpack", "action": "backpack.createInMainHand", "args": {"tier": "gold"}},
        {"id": "set-enchanted-book", "action": "backpack.setStorageSlot", "args": {"item": "minecraft:enchanted_book", "count": 1, "enchantment": "minecraft:sharpness"}},
        {"id": "link-backpack", "action": "backpack.linkHeld"},
        {"id": "open-backpack", "action": "player.useHeldItem"},
        {"id": "await-menu", "action": "await.menu", "args": {"kind": "backpackItem"}},
        {"id": "assert-enchanted-book", "action": "assert.menu", "args": {"kind": "backpackItem", "slot": 0, "item": "minecraft:enchanted_book", "count": 1, "stableTicks": 20}},
        {"id": "close-menu", "action": "menu.close"},
        {"id": "await-closed", "action": "await.menuClosed"}
      ]
    },
    {
      "id": "linked-placed-backpack-opens-with-enchanted-book",
      "tags": ["menu", "linked-storage", "enchanted-item"],
      "timeoutTicks": 400,
      "steps": [
        {"id": "create-backpack", "action": "backpack.createInMainHand", "args": {"tier": "gold"}},
        {"id": "set-enchanted-book", "action": "backpack.setStorageSlot", "args": {"item": "minecraft:enchanted_book", "count": 1, "enchantment": "minecraft:sharpness"}},
        {"id": "link-backpack", "action": "backpack.linkHeld"},
        {"id": "place-backpack", "action": "backpack.placeHeld"},
        {"id": "await-backpack", "action": "await.backpackBlock"},
        {"id": "clear-hand", "action": "player.clearMainHand"},
        {"id": "open-backpack", "action": "player.useTargetBlock"},
        {"id": "await-menu", "action": "await.menu"},
        {"id": "assert-enchanted-book", "action": "assert.menu", "args": {"slot": 0, "item": "minecraft:enchanted_book", "count": 1, "stableTicks": 20}},
        {"id": "close-menu", "action": "menu.close"},
        {"id": "await-closed", "action": "await.menuClosed"}
      ]
    },
    {
      "id": "linked-held-backpack-quick-move-stays-synchronized",
      "tags": ["menu", "linked-storage", "quick-move"],
      "timeoutTicks": 500,
      "steps": [
        {"id": "create-backpack", "action": "backpack.createInMainHand", "args": {"tier": "gold"}},
        {"id": "link-backpack", "action": "backpack.linkHeld"},
        {"id": "set-stick", "action": "player.setInventorySlot", "args": {"slot": 9, "item": "minecraft:stick", "count": 1, "clearMatching": true}},
        {"id": "open-backpack", "action": "player.useHeldItem"},
        {"id": "await-menu", "action": "await.menu", "args": {"kind": "backpackItem"}},
        {"id": "quick-move-stick", "action": "menu.quickMovePlayerInventorySlot", "args": {"inventorySlot": 9}},
        {"id": "assert-stick", "action": "assert.menu", "args": {"kind": "backpackItem", "slot": 0, "item": "minecraft:stick", "count": 1, "stableTicks": 20}},
        {"id": "quick-move-out", "action": "menu.quickMoveBackpackStorageSlot", "args": {"slot": 0}},
        {"id": "assert-storage-empty", "action": "assert.menu", "args": {"kind": "backpackItem", "slot": 0, "item": "minecraft:stick", "count": 0}},
        {"id": "assert-player-stick", "action": "assert.menu", "args": {"kind": "backpackItem", "slot": 8, "item": "minecraft:stick", "count": 1, "playerInventory": true, "stableTicks": 20}},
        {"id": "close-menu", "action": "menu.close"},
        {"id": "await-closed", "action": "await.menuClosed"}
      ]
    },
    {
      "id": "linked-placed-backpack-quick-move-stays-synchronized",
      "tags": ["menu", "linked-storage", "quick-move"],
      "timeoutTicks": 500,
      "steps": [
        {"id": "create-backpack", "action": "backpack.createInMainHand", "args": {"tier": "gold"}},
        {"id": "link-backpack", "action": "backpack.linkHeld"},
        {"id": "set-stick", "action": "player.setInventorySlot", "args": {"slot": 9, "item": "minecraft:stick", "count": 1, "clearMatching": true}},
        {"id": "place-backpack", "action": "backpack.placeHeld"},
        {"id": "await-backpack", "action": "await.backpackBlock"},
        {"id": "clear-hand", "action": "player.clearMainHand"},
        {"id": "open-backpack", "action": "player.useTargetBlock"},
        {"id": "await-menu", "action": "await.menu"},
        {"id": "quick-move-stick", "action": "menu.quickMovePlayerInventorySlot", "args": {"inventorySlot": 9}},
        {"id": "assert-stick", "action": "assert.menu", "args": {"slot": 0, "item": "minecraft:stick", "count": 1, "stableTicks": 20}},
        {"id": "quick-move-out", "action": "menu.quickMoveBackpackStorageSlot", "args": {"slot": 0}},
        {"id": "assert-storage-empty", "action": "assert.menu", "args": {"slot": 0, "item": "minecraft:stick", "count": 0}},
        {"id": "assert-player-stick", "action": "assert.menu", "args": {"slot": 8, "item": "minecraft:stick", "count": 1, "playerInventory": true, "stableTicks": 20}},
        {"id": "close-menu", "action": "menu.close"},
        {"id": "await-closed", "action": "await.menuClosed"}
      ]
    },
    {
      "id": "linked-held-backpack-menu-receives-slot-delta",
      "tags": ["backpack", "linked", "menu", "sync"],
      "timeoutTicks": 450,
      "steps": [
        {"id": "create-backpack", "action": "backpack.createInMainHand", "args": {"tier": "gold"}},
        {"id": "seed-diamonds", "action": "backpack.setStorageSlot", "args": {"item": "minecraft:diamond", "count": 7}},
        {"id": "survival", "action": "fixture.player.setGameMode", "args": {"mode": "survival"}},
        {"id": "create-linker", "action": "player.setInventorySlot", "args": {"slot": 9, "item": "sophisticatedcore:ender_linker", "count": 1}},
        {"id": "open-inventory", "action": "player.openInventory"},
        {"id": "pick-linker", "action": "menu.clickPlayerInventorySlot", "args": {"slot": 9}},
        {"id": "link-backpack", "action": "menu.clickPlayerInventorySlot", "args": {"slot": 0, "button": 1}},
        {"id": "store-linker", "action": "menu.clickPlayerInventorySlot", "args": {"slot": 9}},
        {"id": "close-inventory", "action": "menu.close"},
        {"id": "await-inventory-closed", "action": "await.menuClosed"},
        {"id": "open-backpack", "action": "player.useHeldItem"},
        {"id": "await-menu", "action": "await.menu", "args": {"kind": "backpackItem"}},
        {"id": "assert-initial", "action": "assert.menu", "args": {"kind": "backpackItem", "item": "minecraft:diamond", "count": 7}},
        {"id": "capture-revision", "action": "menu.captureLinkedRevision", "args": {"kind": "backpackItem", "saveAs": "opening"}},
        {"id": "pick-up-diamonds", "action": "menu.clickSlot", "args": {"slot": 0}},
        {"id": "put-down-diamonds", "action": "menu.clickSlot", "args": {"slot": 1}},
        {"id": "assert-delta", "action": "assert.linkedMenuDelta", "args": {"kind": "backpackItem", "baseline": "opening", "slot": 1, "item": "minecraft:diamond", "count": 7}}
      ]
    }
  ]
}
