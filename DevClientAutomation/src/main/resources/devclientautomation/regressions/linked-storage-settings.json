  "tests": [
    {
      "id":"settings-edit-actions-reject-missing-screen",
      "tags":["runtimeConformance"], "timeoutTicks":180,
      "steps":[
        {"id":"tab","action":"menu.clickSettingsControl","args":{"operation":"memory"},"expectFailure":"Settings screen is not open"},
        {"id":"ghost","action":"recipeviewer.dropSettingsGhost","expectFailure":"Settings screen is not open"},
        {"id":"selection","action":"assert.settingsSelection","args":{"display":true},"expectFailure":"Memory/display settings did not persist on server and client; server=no menu; client=no menu"},
        {"id":"baseline","action":"assert.playerInventoryBaseline"}
      ]
    },
    {"id":"barrel-primary-backpack-settings","tags":["linked","settings"],"timeoutTicks":400,"steps":[
