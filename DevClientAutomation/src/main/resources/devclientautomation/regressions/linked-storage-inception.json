{
  "schemaVersion": 2,
  "suiteId": "linked-storage-inception",
  "requires": [],
  "isolation": "testCell",
  "tests": [{
    "id": "canonical-installed-inception-rejects-disabled-and-enabled-child",
    "tags": ["linked-storage", "inception"],
    "timeoutTicks": 500,
    "steps": [
      {"id":"survival","action":"fixture.player.setGameMode","args":{"mode":"survival"}},
      {"id":"parent","action":"backpack.createInMainHand","args":{"tier":"diamond"}},
      {"id":"parent-upgrade","action":"fixture.backpack.setUpgrade","args":{"item":"sophisticatedbackpacks:inception_upgrade"}},
      {"id":"child","action":"player.setInventorySlot","args":{"slot":10,"item":"sophisticatedbackpacks:diamond_backpack","count":1}},
      {"id":"child-disabled-upgrade","action":"fixture.backpack.setUpgrade","args":{"inventorySlot":10,"item":"sophisticatedbackpacks:inception_upgrade","enabled":false}},
      {"id":"parent-linker","action":"player.setInventorySlot","args":{"slot":9,"item":"sophisticatedcore:ender_linker","count":1}},
      {"id":"child-linker","action":"player.setInventorySlot","args":{"slot":12,"item":"sophisticatedcore:ender_linker","count":1}},
      {"id":"inventory","action":"player.openInventory","args":{}},
      {"id":"pick-parent-linker","action":"menu.clickPlayerInventorySlot","args":{"slot":9}},
      {"id":"link-parent","action":"menu.clickPlayerInventorySlot","args":{"slot":0,"button":1}},
      {"id":"store-parent-linker","action":"menu.clickPlayerInventorySlot","args":{"slot":9}},
      {"id":"pick-child-linker","action":"menu.clickPlayerInventorySlot","args":{"slot":12}},
      {"id":"link-child","action":"menu.clickPlayerInventorySlot","args":{"slot":10,"button":1}},
      {"id":"store-child-linker","action":"menu.clickPlayerInventorySlot","args":{"slot":12}},
      {"id":"child-canonical","action":"assert.linkedItemContents","args":{"slot":10,"count":0}},
      {"id":"close-inventory","action":"menu.close","args":{}},
      {"id":"closed","action":"await.menuClosed","args":{}},
      {"id":"open-parent","action":"player.useHeldItem","args":{}},
      {"id":"parent-menu","action":"await.menu","args":{"kind":"backpackItem"}},
      {"id":"attempt-disabled-child","action":"menu.clickStorageSlot","args":{"area":"player","slot":10,"click":"quickMove"}},
      {"id":"parent-still-empty","action":"assert.linkedItemContents","args":{"slot":0,"count":0}},
      {"id":"disabled-child-not-moved","action":"assert.linkedItemContents","args":{"slot":10,"count":0}},
      {"id":"close-parent","action":"menu.close","args":{}},
      {"id":"parent-closed","action":"await.menuClosed","args":{}},
      {"id":"enable-child-upgrade","action":"fixture.backpack.setUpgrade","args":{"inventorySlot":10,"item":"sophisticatedbackpacks:inception_upgrade","enabled":true}},
      {"id":"reopen-parent","action":"player.useHeldItem","args":{}},
      {"id":"parent-menu-again","action":"await.menu","args":{"kind":"backpackItem"}},
      {"id":"attempt-enabled-child","action":"menu.clickStorageSlot","args":{"area":"player","slot":10,"click":"quickMove"}},
      {"id":"parent-remains-empty","action":"assert.linkedItemContents","args":{"slot":0,"count":0}},
      {"id":"enabled-child-not-moved","action":"assert.linkedItemContents","args":{"slot":10,"count":0}},
      {"id":"close-final","action":"menu.close","args":{}},
      {"id":"closed-final","action":"await.menuClosed","args":{}},
      {"id":"same-group-child","action":"fixture.player.copyInventoryItem","args":{"source":0,"target":10}},
      {"id":"open-same-group","action":"player.useHeldItem","args":{}},
      {"id":"same-group-menu","action":"await.menu","args":{"kind":"backpackItem"}},
      {"id":"attempt-same-group","action":"menu.clickStorageSlot","args":{"area":"player","slot":10,"click":"quickMove"}},
      {"id":"same-group-parent-empty","action":"assert.linkedItemContents","args":{"slot":0,"count":0}},
      {"id":"same-group-child-not-moved","action":"assert.linkedItemContents","args":{"slot":10,"count":0}},
      {"id":"close-same-group","action":"menu.close","args":{}},
      {"id":"same-group-closed","action":"await.menuClosed","args":{}},
      {"id":"valid-child","action":"player.setInventorySlot","args":{"slot":10,"item":"sophisticatedbackpacks:diamond_backpack","count":1}},
      {"id":"valid-linker","action":"player.setInventorySlot","args":{"slot":12,"item":"sophisticatedcore:ender_linker","count":1}},
      {"id":"valid-inventory","action":"player.openInventory","args":{}},
      {"id":"pick-valid-linker","action":"menu.clickPlayerInventorySlot","args":{"slot":12}},
      {"id":"link-valid-child","action":"menu.clickPlayerInventorySlot","args":{"slot":10,"button":1}},
      {"id":"store-valid-linker","action":"menu.clickPlayerInventorySlot","args":{"slot":12}},
      {"id":"valid-child-canonical","action":"assert.linkedItemContents","args":{"slot":10,"count":0}},
      {"id":"close-valid-inventory","action":"menu.close","args":{}},
      {"id":"valid-inventory-closed","action":"await.menuClosed","args":{}},
      {"id":"open-valid-parent","action":"player.useHeldItem","args":{}},
      {"id":"valid-parent-menu","action":"await.menu","args":{"kind":"backpackItem"}},
      {"id":"insert-valid-child","action":"menu.clickStorageSlot","args":{"area":"player","slot":10,"click":"quickMove"}},
      {"id":"valid-child-in-parent","action":"assert.linkedItemContents","args":{"slot":0,"count":1}},
      {"id":"close-valid-parent","action":"menu.close","args":{}},
      {"id":"valid-parent-closed","action":"await.menuClosed","args":{}}
    ]
  }]
}
