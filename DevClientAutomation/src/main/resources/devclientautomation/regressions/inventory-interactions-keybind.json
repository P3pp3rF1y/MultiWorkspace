        {"id": "player-cobble", "action": "assert.inventoryInteractionCount", "args": {"target": "player", "item": "minecraft:cobblestone", "count": 2}},
        {"id": "player-dirt", "action": "assert.inventoryInteractionCount", "args": {"target": "player", "item": "minecraft:dirt", "count": 0}}
