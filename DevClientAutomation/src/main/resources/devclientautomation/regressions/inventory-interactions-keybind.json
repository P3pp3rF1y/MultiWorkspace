{
  "schemaVersion": 2,
  "suiteId": "inventory-interactions-keybind",
  "requires": [],
  "isolation": "testCell",
  "tests": [
    {
      "id": "vanilla-transfer-to-storage-filtered",
      "tags": ["behavior", "keybind", "vanilla"],
      "timeoutTicks": 400,
      "steps": [
        {"id": "open", "action": "fixture.openInventoryInteractionMenu", "args": {"kind": "chest", "fixture": "transferToStorage", "saveAs": "opened"}},
        {"id": "await", "action": "await.vanillaMenu", "args": {"ref": "opened", "saveAs": "menu"}},
        {"id": "press", "action": "input.inventoryInteractionKeybind", "args": {"operation": "transferToContainer", "modifier": "none", "ref": "menu"}},
        {"id": "container-cobble", "action": "assert.inventoryInteractionCount", "args": {"target": "container", "ref": "menu", "item": "minecraft:cobblestone", "count": 2}},
        {"id": "container-dirt", "action": "assert.inventoryInteractionCount", "args": {"target": "container", "ref": "menu", "item": "minecraft:dirt", "count": 0}},
        {"id": "player-cobble", "action": "assert.inventoryInteractionCount", "args": {"target": "player", "item": "minecraft:cobblestone", "count": 0}},
        {"id": "player-dirt", "action": "assert.inventoryInteractionCount", "args": {"target": "player", "item": "minecraft:dirt", "count": 1}}
      ]
    },
    {
      "id": "vanilla-transfer-to-storage-all",
      "tags": ["behavior", "keybind", "vanilla"],
      "timeoutTicks": 400,
      "steps": [
        {"id": "open", "action": "fixture.openInventoryInteractionMenu", "args": {"kind": "chest", "fixture": "transferToStorage", "saveAs": "opened"}},
