        {"id": "container-dirt", "action": "assert.inventoryInteractionCount", "args": {"target": "container", "ref": "menu", "item": "minecraft:dirt", "count": 1}},
        {"id": "player-cobble", "action": "assert.inventoryInteractionCount", "args": {"target": "player", "item": "minecraft:cobblestone", "count": 0}},
        {"id": "player-dirt", "action": "assert.inventoryInteractionCount", "args": {"target": "player", "item": "minecraft:dirt", "count": 0}}
      ]
    },
