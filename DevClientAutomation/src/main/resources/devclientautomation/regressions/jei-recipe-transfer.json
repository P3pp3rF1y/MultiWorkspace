  "tests": [
    {
      "id": "backpack-empty-storage-single-closed",
      "tags": [
        "jei",
        "recipe-transfer",
        "backpackItem"
      ],
      "timeoutTicks": 600,
      "steps": [
        {
          "id": "backpack",
          "action": "backpack.createInMainHand",
          "args": {
            "tier": "diamond"
          }
        },
        {
          "id": "upgrade",
          "action": "fixture.backpack.setUpgrade",
          "args": {
            "item": "sophisticatedbackpacks:crafting_upgrade"
          }
        },
        {
          "id": "source",
          "action": "backpack.setStorageSlot",
          "args": {
            "item": "minecraft:oak_planks",
            "count": 4
          }
        },
        {
          "id": "open",
          "action": "player.useHeldItem"
        },
        {
          "id": "menu",
          "action": "await.menu",
          "args": {
            "kind": "backpackItem"
          }
        },
        {
          "id": "tab-closed",
          "action": "menu.setUpgradeTab",
          "args": {
            "open": false
          }
        },
        {
          "id": "transfer",
          "action": "recipeviewer.transferRecipe",
          "args": {
            "recipeResourceID": "minecraft:stick"
          }
        },
        {
          "id": "grid-1",
          "action": "assert.upgradeSlot",
          "args": {
            "slot": 1,
            "item": "minecraft:oak_planks",
            "count": 1
          }
        },
        {
          "id": "grid-4",
          "action": "assert.upgradeSlot",
          "args": {
            "slot": 4,
            "item": "minecraft:oak_planks",
            "count": 1
          }
