{
  "schemaVersion": 2,
  "suiteId": "linked-storage-interoperability",
  "requires": [],
  "isolation": "testCell",
  "tests": [
    {
      "id": "linked-shulker-stashes-into-backpack-canonical-inventory",
      "tags": ["linked", "stash", "shulker", "canonical"],
      "timeoutTicks": 500,
      "steps": [
        {"id": "survival", "action": "fixture.player.setGameMode", "args": {"mode": "survival"}},
        {"id": "backpack", "action": "backpack.createInMainHand", "args": {"tier": "diamond"}},
        {"id": "shulker", "action": "player.setInventorySlot", "args": {"slot": 10, "item": "sophisticatedstorage:shulker_box", "count": 1}},
        {"id": "linker", "action": "player.setInventorySlot", "args": {"slot": 9, "item": "sophisticatedcore:ender_linker", "count": 1}},
        {"id": "marker", "action": "player.setInventorySlot", "args": {"slot": 11, "item": "minecraft:diamond", "count": 7}},
        {"id": "inventory", "action": "player.openInventory"},
        {"id": "pick-linker", "action": "menu.clickPlayerInventorySlot", "args": {"slot": 9}},
        {"id": "create-backpack-primary", "action": "menu.clickPlayerInventorySlot", "args": {"slot": 0, "button": 1}},
        {"id": "store-bound-linker", "action": "menu.clickPlayerInventorySlot", "args": {"slot": 9}},
        {"id": "verify-primary-linked", "action": "assert.linkedItemContents"},
        {"id": "pick-bound-linker", "action": "menu.clickPlayerInventorySlot", "args": {"slot": 9}},
        {"id": "put-bound-linker-in-crafting", "action": "menu.clickPlayerInventorySlot", "args": {"area": "crafting", "slot": 0}},
        {"id": "pick-shulker", "action": "menu.clickPlayerInventorySlot", "args": {"slot": 10}},
        {"id": "put-shulker-in-crafting", "action": "menu.clickPlayerInventorySlot", "args": {"area": "crafting", "slot": 1}},
        {"id": "await-crafted-result", "action": "await.playerCraftingResult"},
        {"id": "take-crafted-secondary", "action": "menu.clickPlayerInventorySlot", "args": {"area": "result"}},
        {"id": "store-crafted-shulker", "action": "menu.clickPlayerInventorySlot", "args": {"slot": 10}},
        {"id": "verify-empty-group", "action": "assert.linkedItemContents", "args": {"slot": 10}},
        {"id": "pick-marker", "action": "menu.clickPlayerInventorySlot", "args": {"slot": 11}},
        {"id": "stash-marker", "action": "menu.clickPlayerInventorySlot", "args": {"slot": 10, "button": 1}},
        {"id": "verify-shulker-canonical", "action": "assert.linkedItemContents", "args": {"slot": 10, "count": 7}},
        {"id": "verify-backpack-canonical", "action": "assert.linkedItemContents", "args": {"slot": 0, "count": 7}},
        {"id": "close-inventory", "action": "menu.close"},
        {"id": "await-closed", "action": "await.menuClosed"},
        {"id": "open-primary", "action": "player.useHeldItem"},
        {"id": "await-primary-menu", "action": "await.menu", "args": {"kind": "backpackItem"}},
        {"id": "verify-menu", "action": "assert.menuUpgradeLayout", "args": {"contents": true}},
        {"id": "close-primary", "action": "menu.close"},
        {"id": "export-canonical-template", "action": "backpack.templateCommand", "args": {"operation": "create", "template": "devclientautomation:canonical_export", "override": true}},
        {"id": "verify-canonical-template", "action": "assert.canonicalBackpackTemplate", "args": {"template": "devclientautomation:canonical_export"}},
        {"id": "delete-template", "action": "backpack.templateCommand", "args": {"operation": "delete", "template": "devclientautomation:canonical_export"}}
      ]
    },
    {
      "id": "storage-primary-crafts-backpack-secondary",
      "tags": ["linked", "craft", "reverse"],
      "timeoutTicks": 500,
      "steps": [
        {"id": "survival", "action": "fixture.player.setGameMode", "args": {"mode": "survival"}},
        {"id": "backpack", "action": "backpack.createInMainHand", "args": {"tier": "leather"}},
        {"id": "shulker", "action": "player.setInventorySlot", "args": {"slot": 10, "item": "sophisticatedstorage:shulker_box", "count": 1}},
        {"id": "linker", "action": "player.setInventorySlot", "args": {"slot": 9, "item": "sophisticatedcore:ender_linker", "count": 1}},
        {"id": "inventory", "action": "player.openInventory"},
        {"id": "pick-linker", "action": "menu.clickPlayerInventorySlot", "args": {"slot": 9}},
        {"id": "create-storage-primary", "action": "menu.clickPlayerInventorySlot", "args": {"slot": 10, "button": 1}},
        {"id": "store-bound-linker", "action": "menu.clickPlayerInventorySlot", "args": {"slot": 9}},
        {"id": "verify-primary-linked", "action": "assert.linkedItemContents", "args": {"slot": 10}},
        {"id": "pick-bound-linker", "action": "menu.clickPlayerInventorySlot", "args": {"slot": 9}},
        {"id": "put-bound-linker-in-crafting", "action": "menu.clickPlayerInventorySlot", "args": {"area": "crafting", "slot": 0}},
        {"id": "pick-backpack", "action": "menu.clickPlayerInventorySlot", "args": {"slot": 0}},
        {"id": "put-backpack-in-crafting", "action": "menu.clickPlayerInventorySlot", "args": {"area": "crafting", "slot": 1}},
        {"id": "await-crafted-result", "action": "await.playerCraftingResult"},
        {"id": "take-crafted-secondary", "action": "menu.clickPlayerInventorySlot", "args": {"area": "result"}},
        {"id": "hold-crafted-backpack", "action": "menu.clickPlayerInventorySlot", "args": {"slot": 0}},
        {"id": "verify-backpack-canonical", "action": "assert.linkedItemContents"},
        {"id": "verify-storage-canonical", "action": "assert.linkedItemContents", "args": {"slot": 10}},
        {"id": "close-inventory", "action": "menu.close"},
        {"id": "await-closed", "action": "await.menuClosed"},
        {"id": "open-secondary", "action": "player.useHeldItem"},
        {"id": "await-secondary-menu", "action": "await.menu", "args": {"kind": "backpackItem"}},
        {"id": "verify-host", "action": "assert.linkedBackpackHost"},
        {"id": "verify-menu", "action": "assert.menuUpgradeLayout", "args": {"contents": true}},
        {"id": "close-secondary", "action": "menu.close"},
        {"id": "attempt-unsupported-template", "action": "backpack.templateCommand", "args": {"operation": "create", "template": "devclientautomation:unsupported_storage_export", "override": true}},
        {"id": "verify-explicitly-unsupported-template", "action": "assert.canonicalBackpackTemplate", "args": {"template": "devclientautomation:unsupported_storage_export", "expectation": "absent"}}
      ]
    }
  ]
}
