# Ignore all root-level paths by default.
/*

# Tracked root files.
!/.gitignore
!/.gitmodules
!/LICENSE
!/README.md
!/build.gradle
!/gradle.properties
!/gradlew
!/gradlew.bat
!/push-all.ps1
!/revert_lineending_diffs.ps1
!/settings.gradle
!/spotless-check.ps1

# Tracked root directories.
!/.github/
!/config/
!/DevClientAutomation/
!/docs/
!/gradle/
!/scripts/
!/src/
!/workspace/
!/Reliquary/
!/SophisticatedBackpacks/
!/SophisticatedBackpacksCreateIntegration/
!/SophisticatedCore/
!/SophisticatedInventoryInteractions/
!/SophisticatedItemActions/
!/SophisticatedStorage/
!/SophisticatedStorageCreateIntegration/
!/SophisticatedStorageInMotion/

# Keep the maintained documentation without exposing local notes.
/docs/*
!/docs/recipe-viewer-regression-fixes.md

# Local artifacts within allowed directories.
/DevClientAutomation/.gradle/
/DevClientAutomation/build/
/DevClientAutomation/bin/
/DevClientAutomation/logs/
/workspace/build/
/workspace/run/
/workspace/run2/
/workspace/run3/
