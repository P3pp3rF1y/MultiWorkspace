  "tests": [
    {
      "name": "basic backpack shows its crafting recipe",
      "type": "recipe",
      "focus": { "item": "sophisticatedbackpacks:backpack" },
      "expect": {
        "categoryPattern": "crafting|craft",
        "inputs": [],
        "outputs": [
          {
            "anyOf": [
              {
                "item": "sophisticatedbackpacks:backpack",
                "absent": [
                  "encoded.components.sophisticatedcore:main_color",
                  "encoded.components.sophisticatedcore:accent_color"
                ]
              },
              {
                "item": "sophisticatedbackpacks:backpack",
                "match": {
                  "encoded.components.sophisticatedcore:main_color": -3382982,
                  "encoded.components.sophisticatedcore:accent_color": -10342886
                }
              }
            ]
          }
        ]
      }
    },
    {
      "name": "untinted backpack has dye usage producing tinted backpacks",
      "type": "use",
      "focus": { "item": "sophisticatedbackpacks:backpack" },
      "expect": {
        "categoryPattern": "crafting|craft",
        "inputs": [
          { "item": "sophisticatedbackpacks:backpack" },
          { "itemPattern": "^minecraft:.*_dye$" }
        ],
        "outputs": [
          {
            "item": "sophisticatedbackpacks:backpack",
            "componentsPattern": "main_color|accent_color"
          }
        ]
      }
    },
    {
      "name": "creative red backpack shows its dye recipe",
      "type": "recipe",
      "viewers": ["jei", "rei"],
      "focus": "redBackpack",
      "expect": {
        "categoryPattern": "crafting|craft",
        "inputs": [
          { "item": "minecraft:red_dye" }
        ],
        "outputs": [
          { "sameAs": "redBackpack" }
        ],
        "expectedMatches": 1
      }
    },
    {
      "name": "untinted backpack tier upgrade usages are visible",
      "type": "chain",
      "steps": [
        {
          "source": "sophisticatedbackpacks:backpack",
          "focus": { "item": "sophisticatedbackpacks:backpack" },
          "result": "sophisticatedbackpacks:copper_backpack",
          "categoryPattern": "^minecraft:crafting$|^Crafting$"
        },
        {
          "source": "sophisticatedbackpacks:backpack",
          "focus": { "item": "sophisticatedbackpacks:backpack" },
          "result": "sophisticatedbackpacks:iron_backpack",
          "categoryPattern": "^minecraft:crafting$|^Crafting$"
        },
        {
          "source": "sophisticatedbackpacks:copper_backpack",
          "focus": { "item": "sophisticatedbackpacks:copper_backpack" },
          "result": "sophisticatedbackpacks:iron_backpack",
          "categoryPattern": "^minecraft:crafting$|^Crafting$"
        },
        {
          "source": "sophisticatedbackpacks:iron_backpack",
          "focus": { "item": "sophisticatedbackpacks:iron_backpack" },
          "result": "sophisticatedbackpacks:gold_backpack",
          "categoryPattern": "^minecraft:crafting$|^Crafting$"
        },
        {
          "source": "sophisticatedbackpacks:gold_backpack",
          "focus": { "item": "sophisticatedbackpacks:gold_backpack" },
          "result": "sophisticatedbackpacks:diamond_backpack",
          "categoryPattern": "^minecraft:crafting$|^Crafting$"
        }
      ]
    },
    {
      "name": "iron backpack recipe can come from basic backpack",
      "type": "recipe",
      "focus": "craftedIronBackpack",
      "expect": {
        "categoryPattern": "^minecraft:crafting$|^Crafting$",
        "inputs": [
          { "item": "sophisticatedbackpacks:backpack" }
        ],
        "outputs": [
          { "sameAs": "craftedIronBackpack" }
