      },
      "noLogPatterns": [
        "FATAL",
        "Reported exception",
        "Rendering screen",
        "Extracting render state",
        "Tried to access entity ID before ID assignment"
      ],
      "allowedLogContextPatterns": [
        "FramerateLimitTracker\\.onInputReceived"
      ]
    },
    {
      "id": "storage.paintbrush_smoke",
      "name": "Storage paintbrush color application smoke",
      "type": "endpoint",
      "priority": "high",
      "timeoutSeconds": 360,
      "skipRecipeViewerReady": true,
      "method": "POST",
